# Copy to .env before starting the stack:
#
#   cp .env.example .env
#
# .env is gitignored. These values are consumed at runtime only — nothing here
# is baked into the image, so the same artefact runs in every environment.

POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-before-you-use-this
POSTGRES_DB=app

# Host port the API is published on. The database is deliberately not published.
APP_PORT=3000
